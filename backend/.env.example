# --- Required ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# --- Models: ordered fallback chain ---
# The first model answers. If it is rate-limited (429) or unhealthy it is put on
# a cooldown and the next one takes over automatically — the visitor sees no error.
# Comma-separated, best first. Only chat models with a 128k context belong here.
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,llama-3.1-8b-instant,openai/gpt-oss-safeguard-20b

# --- Cross-provider fallback (optional but recommended) ---
# Google's free tier is a completely separate quota from Groq's, so the chat
# keeps working on a day when every Groq model is exhausted.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# --- How long a model sits out after failing (seconds) ---
COOLDOWN_RATE_LIMITED=60
COOLDOWN_SERVER_ERROR=20
COOLDOWN_UNAVAILABLE=1800

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Conversation / input limits ---
MAX_HISTORY_MESSAGES=20
MAX_QUESTION_CHARS=2000
MAX_JD_CHARS=12000

# --- Rate limiting (per client IP) ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Owner access ---
# Unlocks the profile-edit endpoints AND the chat log: reading it, exporting it
# to Excel, and deleting it. Without this, questions are still recorded but
# nobody — including you — can open or clear the log. Use a long random string;
# it is the only thing standing between a stranger and every visitor's details.
# ADMIN_TOKEN=choose-a-long-random-string

# --- Chat log: every question a visitor asks, saved for the Excel export ---
CHAT_LOG_ENABLED=true
# IMPORTANT on Render's free plan: the filesystem is wiped on every deploy and
# cold start, so the default path loses history. Attach a persistent disk and
# point this at it (e.g. /var/data/chat_log.jsonl) to keep the log for good.
# CHAT_LOG_PATH=./data/chat_log.jsonl
# Oldest rows are dropped past this ceiling. 0 = keep everything forever.
CHAT_LOG_MAX_ROWS=20000

# --- Optional: fill the City / Region / Country / ISP columns of the log ---
# Turning this on sends visitor IP addresses to ip-api.com (free, no key).
# Leave it off to keep those columns blank and no IP leaving your server.
GEO_LOOKUP_ENABLED=false

# --- Optional: point at a different profile file ---
# PROFILE_PATH=./data/profile.json
